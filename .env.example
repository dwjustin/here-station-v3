# Backend only. Start local uvicorn with --env-file ../.env.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=station-maps
DATA_GO_KR_SERVICE_KEY=
# Local maps: data/maps/{station_id}.json (override with MAP_DIR).
# RENDER=true downloads maps from STORAGE_BUCKET instead of local files.
