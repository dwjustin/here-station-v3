{
  "expo": {
    "name": "Here Station",
    "slug": "here-station",
    "scheme": "herestation",
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Bold.otf"
          ]
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "telemetry": false,
          "provider": "none",
          "ios": {
            "cameraUsagePermission": "주변을 보며 길을 안내받으려면 카메라 접근을 허용해 주세요."
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "걸음을 세어 현재 위치를 추정하려면 동작 센서 접근을 허용해 주세요."
        }
      ],
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "말로 출발역과 도착역을 알려 주려면 마이크 접근을 허용해 주세요.",
          "speechRecognitionPermission": "말한 역 이름을 알아들으려면 음성 인식을 허용해 주세요."
        }
      ]
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dwjustin.herestation",
      "appleTeamId": "6M9WRXSJ53",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "개발 PC의 앱 개발 서버와 길 안내 API에 연결하려면 로컬 네트워크 접근을 허용해 주세요."
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.dwjustin.herestation",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
